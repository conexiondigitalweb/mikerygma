{
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/preview.js": {
      "maxDuration": 30
    },
    "api/save-generation.js": {
      "maxDuration": 30
    },
    "api/wompi/create-signature.js": {
      "maxDuration": 15
    },
    "api/wompi/webhook.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
